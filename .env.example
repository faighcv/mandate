# LLM provider: "anthropic", "openai" or "sim" (scripted, no key needed).
# Leave blank to auto-detect from whichever API key is set.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Airwallex sandbox. Leave blank to run against the built-in simulated ledger.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_WEBHOOK_SECRET=

# Public URL of this app (used for payment-link checkout pages and TAP merchant calls).
APP_URL=http://localhost:3000

# Optional: a password that gates the whole app on public deployments.
DEMO_PASSWORD=
